<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.RegisterController"
      alignment="CENTER" spacing="20"
      stylesheets="@style.css"
      prefWidth="450" prefHeight="500"
      style="-fx-background-color: #070d1a;">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="8">
        <Label text="⚡ BIDHOUND" styleClass="price-label" style="-fx-font-size: 32px;"/>
        <Label text="Tạo Tài Khoản Mới" styleClass="sub-label"/>
    </VBox>

    <VBox spacing="15" styleClass="card" style="-fx-padding: 25px;">
        <Label text="ĐĂNG KÝ TÀI KHOẢN" styleClass="title-label" style="-fx-font-size: 18px;"/>
        
        <VBox spacing="6">
            <Label text="Tên đăng nhập:" styleClass="sub-label"/>
            <TextField fx:id="usernameField" promptText="Nhập username..."/>
        </VBox>

        <VBox spacing="6">
            <Label text="Email:" styleClass="sub-label"/>
            <TextField fx:id="emailField" promptText="Nhập email..."/>
        </VBox>

        <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"/>

        <HBox spacing="12" alignment="CENTER">
            <Button text="Đăng Ký" onAction="#handleRegister" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Quay lại Đăng Nhập" onAction="#handleBackToLogin" styleClass="btn-quick" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>
</VBox>
