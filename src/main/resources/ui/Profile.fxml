<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.ProfileController"
            stylesheets="@style.css"
            prefWidth="900" prefHeight="640"
            style="-fx-background-color: #070d1a;">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="card" style="-fx-padding: 15px 25px; -fx-background-radius: 0 0 16px 16px;">
            <Button text="⬅ Quay Lại Sảnh Đấu Giá" onAction="#handleBackToLobby" styleClass="btn-quick"/>
            <Label text="TRANG CÁ NHÂN &amp; LỊCH SỬ ĐẤU GIÁ" styleClass="title-label" style="-fx-font-size: 18px;"/>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="20" style="-fx-padding: 25px;">
            <!-- USER INFO CARD -->
            <HBox spacing="20" styleClass="card" style="-fx-padding: 20px;" alignment="CENTER_LEFT">
                <!-- Tên + ID -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="userNameLabel" text="Tài khoản: User" styleClass="title-label" style="-fx-font-size: 20px;"/>
                    <Label fx:id="userIdLabel" text="ID: #1001" styleClass="sub-label"/>
                </VBox>

                <!-- Số dư -->
                <VBox spacing="5" alignment="CENTER_RIGHT">
                    <Label text="SỐ DƯ HIỆN TẠI" styleClass="sub-label"/>
                    <Label fx:id="balanceLabel" text="0 ₫" styleClass="price-label"/>
                </VBox>

                <!-- Nạp tiền linh hoạt -->
                <VBox spacing="8" alignment="CENTER_RIGHT" style="-fx-padding: 0 0 0 20;">
                    <Label text="NẠP TIỀN (₫)" styleClass="sub-label"/>
                    <HBox spacing="8" alignment="CENTER">
                        <TextField fx:id="topUpAmountField"
                                   promptText="VD: 500000"
                                   prefWidth="140"
                                   style="-fx-background-color: #1a2540; -fx-text-fill: #f1f5f9;
                                          -fx-border-color: #2a3f6f; -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 8 12;"/>
                        <Button text="💵 Nạp" onAction="#handleTopUp" styleClass="btn-primary"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- AUCTION HISTORY TABLE -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="LỊCH SỬ CÁC PHIÊN ĐẤU GIÁ ĐÃ THAM GIA" styleClass="sub-label"
                       style="-fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                <TableView fx:id="historyTableView" VBox.vgrow="ALWAYS" styleClass="card">
                    <columns>
                        <TableColumn fx:id="itemIdCol"  text="Mã SP"              prefWidth="80"/>
                        <TableColumn fx:id="titleCol"   text="Tên Sản Phẩm"       prefWidth="270"/>
                        <TableColumn fx:id="priceCol"   text="Giá Cuối Cùng"      prefWidth="150"/>
                        <TableColumn fx:id="statusCol"  text="Trạng Thái Phiên"   prefWidth="130"/>
                        <TableColumn fx:id="resultCol"  text="Kết Quả Thắng/Thua" prefWidth="200"/>
                    </columns>
                    <placeholder>
                        <Label text="Chưa có lịch sử tham gia đấu giá nào." styleClass="sub-label"/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
