<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="220.0" spacing="10.0"
      style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1;"
      xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ItemCardController">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
    </padding>
    <effect>
        <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
            <color>
                <Color red="0.0" green="0.0" blue="0.0" opacity="0.06" />
            </color>
        </DropShadow>
    </effect>
    <children>
        <!-- Tên sản phẩm -->
        <Label fx:id="titleLabel" text="Tên sản phẩm mẫu" wrapText="true"
               style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #1e293b;" prefHeight="42.0" alignment="TOP_LEFT" />

        <!-- Khối hiển thị Giá -->
        <VBox spacing="2.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 8;">
            <children>
                <Label text="Giá hiện tại" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                <Label fx:id="priceLabel" text="$0.00"
                       style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2563eb;" />
            </children>
        </VBox>

        <!-- Khối Thời gian còn lại -->
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <children>
                <Label text="Thời gian:" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                <Label fx:id="durationLabel" text="00:00:00"
                       style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #d97706;" />
            </children>
        </HBox>

        <!-- Nút thao tác -->
        <Button fx:id="actionButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                onAction="#handleAction" text="Đấu giá ngay"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 0; -fx-cursor: hand;" />
    </children>
</VBox>